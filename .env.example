# RNA Lab Navigator - Environment Configuration
# Copy this to .env and fill in your values

# Database Configuration
DB_PASSWORD=generate_a_strong_password_here

# Django Configuration
SECRET_KEY=generate_with_django_command_or_use_random_string
DEBUG=False

# OpenAI Configuration (Required for embeddings and LLM)
OPENAI_API_KEY=sk-proj-YOUR_ACTUAL_KEY_HERE

# Network Configuration
LAB_STATIC_IP=YOUR.LAB.STATIC.IP

# Admin User Configuration
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@rnalab.com
DJANGO_SUPERUSER_PASSWORD=ChangeThisStrongPassword123!

# Optional: Email Configuration (for notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=True

# Optional: Sentry for Error Tracking
SENTRY_DSN=

# Resource Limits (adjust based on your NAS)
CELERY_WORKER_MAX_MEMORY=2048  # MB
MAX_UPLOAD_SIZE=104857600  # 100MB in bytes

# Feature Flags
ENABLE_CROSS_ENCODER=True
ENABLE_LOCAL_EMBEDDINGS=True
ENABLE_HYBRID_SEARCH=True

# Weaviate Configuration
WEAVIATE_BATCH_SIZE=100
WEAVIATE_TIMEOUT=30